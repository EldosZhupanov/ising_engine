+// Qualification observer only: one search worker; never changes search state/RNG.
+void qualification_observe(const Gene *seq, int N, Fitness energy) {
+    static Fitness observed_best = INT_MAX;
+    if (energy >= observed_best) return;
+    observed_best = energy;
+    printf("\nINC %d ", energy);
+    for (int i = 0; i < N; ++i) putchar(seq[i] == 1 ? '0' : '1');
+    putchar('\n');
+    fflush(stdout);
+}
